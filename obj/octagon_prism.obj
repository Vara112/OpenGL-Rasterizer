# triangulated octagonal prism (two 8-sided caps + 8 side walls)
# faces use the v/vt/vn form so it matches your sscanf("%d/%d/%d", ...) parsing

# top cap ring (z = 1), vertices 1-8
v 1.00000 0.00000 1.00000
v 0.70711 0.70711 1.00000
v 0.00000 1.00000 1.00000
v -0.70711 0.70711 1.00000
v -1.00000 0.00000 1.00000
v -0.70711 -0.70711 1.00000
v 0.00000 -1.00000 1.00000
v 0.70711 -0.70711 1.00000

# bottom cap ring (z = -1), vertices 9-16
v 1.00000 0.00000 -1.00000
v 0.70711 0.70711 -1.00000
v 0.00000 1.00000 -1.00000
v -0.70711 0.70711 -1.00000
v -1.00000 0.00000 -1.00000
v -0.70711 -0.70711 -1.00000
v 0.00000 -1.00000 -1.00000
v 0.70711 -0.70711 -1.00000

# dummy texture coord / normal so the v/vt/vn references are valid
vt 0.0 0.0
vn 0.0 0.0 1.0

# top cap (fan triangulation from vertex 1)
f 1/1/1 2/1/1 3/1/1
f 1/1/1 3/1/1 4/1/1
f 1/1/1 4/1/1 5/1/1
f 1/1/1 5/1/1 6/1/1
f 1/1/1 6/1/1 7/1/1
f 1/1/1 7/1/1 8/1/1

# bottom cap (fan triangulation from vertex 9, reversed winding)
f 9/1/1 11/1/1 10/1/1
f 9/1/1 12/1/1 11/1/1
f 9/1/1 13/1/1 12/1/1
f 9/1/1 14/1/1 13/1/1
f 9/1/1 15/1/1 14/1/1
f 9/1/1 16/1/1 15/1/1

# side walls (8 quads, each split into 2 triangles)
f 1/1/1 2/1/1 10/1/1
f 1/1/1 10/1/1 9/1/1
f 2/1/1 3/1/1 11/1/1
f 2/1/1 11/1/1 10/1/1
f 3/1/1 4/1/1 12/1/1
f 3/1/1 12/1/1 11/1/1
f 4/1/1 5/1/1 13/1/1
f 4/1/1 13/1/1 12/1/1
f 5/1/1 6/1/1 14/1/1
f 5/1/1 14/1/1 13/1/1
f 6/1/1 7/1/1 15/1/1
f 6/1/1 15/1/1 14/1/1
f 7/1/1 8/1/1 16/1/1
f 7/1/1 16/1/1 15/1/1
f 8/1/1 1/1/1 9/1/1
f 8/1/1 9/1/1 16/1/1
